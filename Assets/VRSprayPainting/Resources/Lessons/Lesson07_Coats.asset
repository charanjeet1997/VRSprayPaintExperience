    RefIds:
    - rid: 5184086490568459201
      type: {class: ExplainStep, ns: VRSprayPainting, asm: Assembly-CSharp}
      data:
        title: 
        body: 'Real spray paint goes on in thin coats.


          The first coat
          looks patchy and the old colour shows through. That''s normal.

          Let
          it dry, then a second coat covers evenly.

          One heavy coat instead
          runs, sags and stays tacky.'
        buttonLabel: Start
    - rid: 5184086490568459202
      type: {class: PracticeStep, ns: VRSprayPainting, asm: Assembly-CSharp}
      data:
        instruction: 'Coat 1: paint the whole panel in 6 overlapping passes.

          It
          will look patchy. That''s right.'
        reading: {fileID: 11400000, guid: f3c0a05ce4867d2458c8a1d57f8c2260, type: 2}
        goal:
          rid: 5184086490568459206
        cleanPanel: 1
        showCues: 1
    - rid: 5184086490568459203
      type: {class: PracticeStep, ns: VRSprayPainting, asm: Assembly-CSharp}
      data:
        instruction: 'Let it dry. Watch the sign above the panel.

          Don''t
          spray yet.'
        reading: {fileID: 0}
        goal:
          rid: 5184086490568459207
        cleanPanel: 0
        showCues: 1
    - rid: 5184086490568459204
      type: {class: PracticeStep, ns: VRSprayPainting, asm: Assembly-CSharp}
      data:
        instruction: 'Coat 2: paint the whole panel again in 6 overlapping passes.'
        reading: {fileID: 11400000, guid: f3c0a05ce4867d2458c8a1d57f8c2260, type: 2}
