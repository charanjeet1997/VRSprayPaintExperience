  m_Script: {fileID: 11500000, guid: 6733ab7eb86d20d4084a4db0b6c21eed, type: 3}
  m_Name: Lesson03_Speed
  m_EditorClassIdentifier: Assembly-CSharp::VRSprayPainting.LessonData
  lessonId: lesson03_speed
  title: Move at a steady speed
  summary: Not too slow, not too fast.
  prerequisites:
  - {fileID: 11400000, guid: 1daf543732ff4d147be981e9f91984f7, type: 2}
  sprayers: []
  steps:
  - rid: 5184086490568459051
  - rid: 5184086490568459052
  - rid: 5184086490568459053
  - rid: 5184086490568459054
  references:
    version: 2
    RefIds:
    - rid: 5184086490568459051
      type: {class: ExplainStep, ns: VRSprayPainting, asm: Assembly-CSharp}
      data:
        title: 
        body: 'Speed decides how much paint lands.


          Too slow: paint piles
          up and runs.

          Too fast: a thin, see-through coat.

          Steady,
          about one sweep across the panel every two to three seconds, gives an even
          coat.'
        buttonLabel: Watch demo
    - rid: 5184086490568459052
      type: {class: DemoStep, ns: VRSprayPainting, asm: Assembly-CSharp}
      data:
        moves:
        - caption: 'Too slow: paint piles up and starts to run.'
          from: {x: -0.45, y: 0.3}
          to: {x: -0.05, y: 0.3}
          distance: 0.2
          tilt: 0
          duration: 5
          spray: 1
          switchColor: 0
          shake: 0
        - caption: 'Too fast: a thin, patchy stripe.'
          from: {x: 0.45, y: 0.05}
          to: {x: -0.45, y: 0.05}
          distance: 0.2
          tilt: 0
          duration: 0.6
          spray: 1
          switchColor: 0
          shake: 0
        - caption: 'Steady pace: an even, solid stripe.'
          from: {x: -0.45, y: -0.25}
          to: {x: 0.45, y: -0.25}
          distance: 0.2
          tilt: 0
          duration: 2.4
          spray: 1
          switchColor: 0
          shake: 0
    - rid: 5184086490568459053
      type: {class: PracticeStep, ns: VRSprayPainting, asm: Assembly-CSharp}
      data:
        instruction: 'Paint the panel in steady side-to-side passes.

          Keep
          the speed above the sprayer GREEN.'
        reading: {fileID: 11400000, guid: b64cb1a78ddb0fa49a05623f21f877a4, type: 2}
        goal:
          rid: 5184086490568459055
        cleanPanel: 1
    - rid: 5184086490568459054
      type: {class: AssessStep, ns: VRSprayPainting, asm: Assembly-CSharp}
      data:
        skills:
        - {fileID: 11400000, guid: 7311a862061d94f4ca9de3a17a6f3b62, type: 2}
        - {fileID: 11400000, guid: d5dc5276ed8325e48b588d59cb78f0ce, type: 2}
        defects:
        - {fileID: 11400000, guid: b81ec75cb69cc484f96fe509a5f55843, type: 2}
        - {fileID: 11400000, guid: 4e3fc8d45a6fb8047b78debeef6059da, type: 2}
    - rid: 5184086490568459055
      type: {class: SprayTimeGoal, ns: VRSprayPainting, asm: Assembly-CSharp}
      data:
        seconds: 12
