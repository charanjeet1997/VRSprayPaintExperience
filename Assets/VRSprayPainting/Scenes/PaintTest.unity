MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 921454923}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 670676cd70137ee4c8f5e6647001ba4c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VRSprayPainting.SprayDemoController
  sprayGun: {fileID: 883532800}
  sprayPainter: {fileID: 883532802}
  gunGrab: {fileID: 883532801}
  gunBody: {fileID: 883532805}
  paintReset: {fileID: 921454924}
  demoAnchor: {fileID: 671284554}
  areaSize: {x: 0.7, y: 0.7}
  secondColor: {r: 0.1, g: 0.35, b: 0.95, a: 1}
  travelTime: 0.6
  flyTime: 1.2
  endHold: 1.5
  moves:
  - caption: Hold the gun 15-30 cm away, straight on. The ring turns GREEN in the
      sweet spot.
    from: {x: -0.45, y: 0.3}
    to: {x: -0.45, y: 0.3}
    distance: 0.22
    tilt: 0
    duration: 1.2
    spray: 0
    switchColor: 0
    shake: 0
  - caption: Smooth, steady passes in the green zone give an even coat.
    from: {x: -0.45, y: 0.3}
    to: {x: 0.45, y: 0.3}
    distance: 0.22
    tilt: 0
    duration: 2.2
    spray: 1
    switchColor: 0
    shake: 0
  - caption: Overlap each pass by about half.
    from: {x: 0.45, y: 0.15}
    to: {x: -0.45, y: 0.15}
    distance: 0.22
    tilt: 0
    duration: 2.2
    spray: 1
    switchColor: 0
    shake: 0
  - caption: 'Too close (ORANGE): a small, heavy, wet spot.'
    from: {x: -0.4, y: -0.05}
    to: {x: 0.4, y: -0.05}
    distance: 0.07
    tilt: 0
    duration: 2
    spray: 1
    switchColor: 0
    shake: 0
  - caption: 'Too far (YELLOW): thin, dry and speckled.'
    from: {x: 0.45, y: -0.3}
    to: {x: -0.45, y: -0.3}
    distance: 0.4
    tilt: 0
    duration: 2.2
    spray: 1
    switchColor: 0
    shake: 0
  - caption: 'New colour over old paint blends like real paint: thin = tinted, heavy
      = covers.'
    from: {x: 0, y: 0.42}
    to: {x: 0, y: 0.42}
    distance: 0.22
    tilt: 0
    duration: 1.2
    spray: 0
    switchColor: 1
    shake: 0
  - caption: 'New colour over old paint blends like real paint: thin = tinted, heavy
      = covers.'
    from: {x: 0, y: 0.42}
    to: {x: 0, y: -0.42}
    distance: 0.22
    tilt: 0
    duration: 3
    spray: 1
    switchColor: 0
    shake: 0
