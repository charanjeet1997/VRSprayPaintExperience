  - caption: Hold the gun 15-30 cm away, straight on. The ring turns GREEN in the
      sweet spot.
    from: {x: -0.45, y: 0.3}
    to: {x: -0.45, y: 0.3}
    distance: 0.22
    duration: 1.2
    spray: 0
    switchColor: 0
  - caption: Smooth, steady passes in the green zone give an even coat.
    from: {x: -0.45, y: 0.3}
    to: {x: 0.45, y: 0.3}
    distance: 0.22
    duration: 2.2
    spray: 1
    switchColor: 0
  - caption: Overlap each pass by about half.
    from: {x: 0.45, y: 0.15}
    to: {x: -0.45, y: 0.15}
    distance: 0.22
    duration: 2.2
    spray: 1
    switchColor: 0
  - caption: 'Too close (ORANGE): a small, heavy, wet spot.'
    from: {x: -0.4, y: -0.05}
    to: {x: 0.4, y: -0.05}
    distance: 0.07
    duration: 2
    spray: 1
    switchColor: 0
  - caption: 'Too far (YELLOW): thin, dry and speckled.'
    from: {x: 0.45, y: -0.3}
    to: {x: -0.45, y: -0.3}
    distance: 0.4
    duration: 2.2
    spray: 1
    switchColor: 0
  - caption: 'New colour over old paint blends like real paint: thin = tinted, heavy
      = covers.'
    from: {x: 0, y: 0.42}
    to: {x: 0, y: 0.42}
    distance: 0.22
    duration: 1.2
    spray: 0
    switchColor: 1
  - caption: 'New colour over old paint blends like real paint: thin = tinted, heavy
      = covers.'
    from: {x: 0, y: 0.42}
    to: {x: 0, y: -0.42}
    distance: 0.22
    duration: 3
    spray: 1
    switchColor: 0
