  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 Paint ran: you held the spray on one spot for 1.3 s. Too much paint
    in one place runs and sags. Keep moving while the trigger is pressed.\n\u2022
    Orange peel: spraying too close blasts wet paint into a bumpy, dimpled surface
    like orange skin instead of letting it level out. Hold the sprayer 15-25 cm away.\n\u2022
    The coat is patchy: some areas thick, some thin. Keep the same speed and distance
    on every pass.\n\u2022 You started or stopped spraying on the panel 9 times.
    Each start and stop dumps extra paint there, leaving heavy spots at the edges.
    Press the trigger just before the panel and release just after it."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
