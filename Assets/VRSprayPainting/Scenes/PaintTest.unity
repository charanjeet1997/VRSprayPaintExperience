--- !u!114 &921454926
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 921454923}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d7207dd55054424ba5f330c975b2ebc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VRSprayPainting.OnboardingController
  gunGrab: {fileID: 883532801}
  sprayPainter: {fileID: 883532802}
  demo: {fileID: 921454928}
  gunHint: {fileID: 2034200199}
  targetHint: {fileID: 1431020378}
  paletteHint: {fileID: 1745449684}
  buildUpStamps: 45
  successDuration: 1.2
  steps:
  - type: 0
    title: Welcome to the paint booth
    body: 'You''ll learn to spray paint in a few quick steps.

      Point at a button
      with your controller and pull the trigger to press it.'
    successText: 
    primaryLabel: Watch demo
    inputHint: TRIGGER  to press
  - type: 1
    title: Watch the spray gun
    body: The spray gun will show you how it's done.
    successText: 
    primaryLabel: Skip demo
    inputHint: 
  - type: 2
    title: Pick up the spray gun
    body: 'The spray gun is on the stool to your right.

      Reach out and hold
      the GRIP button to pick it up.'
    successText: Got it!
    primaryLabel: 
    inputHint: Hold GRIP
  - type: 3
    title: Spray the panel
    body: Aim the nozzle at the grey panel or the cube and pull the TRIGGER.
    successText: Nice, that's paint!
    primaryLabel: 
    inputHint: Pull TRIGGER
  - type: 4
    title: Build up the coat
    body: 'Spray in smooth passes, gun straight on. Keep the ring GREEN (15-30 cm).

      Too
      close = heavy, too far = dry and speckled. Thumbstick up/down = tighter/wider
      spray.'
    successText: Great coverage!
    primaryLabel: 
    inputHint: Hold TRIGGER  +  Stick
  - type: 5
    title: Change colour
    body: Use the palette on your right. Point at a colour and pull the trigger.
    successText: New colour loaded.
    primaryLabel: 
    inputHint: Point + TRIGGER
  - type: 6
    title: Start over
    body: Press B or Y on your controller, or 'Clear paint' on the palette, to wipe
      every surface clean.
    successText: All clean.
    primaryLabel: 
    inputHint: B  or  Y
  - type: 7
    title: You're ready!
    body: 'Paint freely. Dropped the gun? It returns to the stool by itself.

      Open
      this guide again from the palette any time.'
    successText: 
    primaryLabel: Hide guide
    inputHint: 
